# ═══════════════════════════════════════════════════════════════════════════
# ⚠️ 외부 API 키는 2026-08-22 이후 전부 해지될 예정입니다.
#
# 키를 비워두거나 아래 "여기에_..." 플레이스홀더 그대로 두면 서버는 **안전 모드**로 뜹니다.
# 외부 API를 호출하지 않고 목(mock) 응답을 돌려주므로, 키 없이도 서버 기동·테스트·화면
# 확인이 전부 됩니다(pytest 265건도 키 없이 통과합니다).
#
# 🚨 반대로 **해지된 키를 값만 남겨두면 안 됩니다.** 안전 모드 판정은 "키가 있는가"만 보고
#    유효성은 보지 않기 때문에, 죽은 키가 있으면 서버가 실호출을 시도했다가 401을 맞고
#    502로 실패합니다. 해지할 때는 값을 지우거나 플레이스홀더로 되돌리세요.
# ═══════════════════════════════════════════════════════════════════════════

# Naver CLOVA Studio API 키 정보 (대본 생성용)
HCX_API_KEY=여기에_API_KEY를_붙여넣으세요

# ETRI 오픈 API 키 (단어 분석용)
ETRI_API_KEY=여기에_ETRI_API_KEY를_붙여넣으세요

# MS Azure Speech API 키 정보 (발음 평가용)
AZURE_SPEECH_KEY=여기에_AZURE_KEY를_붙여넣으세요
AZURE_SPEECH_REGION=koreacentral

# Naver Clova Voice API 키 정보 (음성 합성/TTS용 — POST /api/tts/word)
# ⚠️ 이것만 구독제입니다(월 기본료 90,000원, 100만 자 포함). 한 글자도 안 써도 매월 나가므로
#    다른 키와 달리 "안 쓰면 0원"이 아닙니다. 해지 타이밍을 콘솔 청구 주기에 맞추세요.
CLOVA_VOICE_CLIENT_ID=여기에_CLOVA_VOICE_CLIENT_ID를_붙여넣으세요
CLOVA_VOICE_CLIENT_SECRET=여기에_CLOVA_VOICE_CLIENT_SECRET을_붙여넣으세요

# SpeaKO 자체 API 인증 키 (/api/* 호출 시 X-API-Key 헤더로 검증)
# 비워두거나 플레이스홀더 상태면 인증이 꺼진 채로(로컬 개발 편의) 동작합니다.
# 배포 전에는 반드시 실제 값으로 채워서 무인증 호출을 막으세요.
SPEAKO_API_KEY=여기에_SPEAKO_API_KEY를_붙여넣으세요

# 국립국어원 표준국어대사전 오픈 API 키 (발음 정보 조회 — 장단음 판정용)
# https://stdict.korean.go.kr/openapi/openApiInfo.do 에서 발급
STDICT_API_KEY=여기에_STDICT_API_KEY를_붙여넣으세요

# ── 배포 설정 ────────────────────────────────────────────────────────────────
# 브라우저에서 이 API를 직접 호출하는 프론트엔드의 출처(origin) 목록. 쉼표로 구분.
# 비워두면 localhost(3000/5173) + https://speakofront.vercel.app 이 기본 허용됩니다.
# 여기에 없는 출처에서 호출하면 브라우저가 응답을 차단하므로, 배포 도메인이 바뀌면 꼭 갱신하세요.
CORS_ALLOW_ORIGINS=
# Vercel 프리뷰처럼 도메인이 매번 바뀌는 경우를 위한 정규식 (기본: 모든 *.vercel.app 허용)
CORS_ALLOW_ORIGIN_REGEX=

# HCX 동시 호출 개수. 대본은 슬라이드마다 1회씩 호출하므로 이 값만큼 병렬로 나갑니다.
# 너무 올리면 레이트리밋에 걸립니다. (기본 4)
HCX_MAX_CONCURRENCY=4
# 백그라운드 대본 생성 작업을 동시에 몇 개까지 돌릴지 (기본 4)
SCRIPT_JOB_CONCURRENCY=4
# 사용할 HCX 모델명 (기본 HCX-005)
HCX_MODEL_NAME=HCX-005
# 발음 듣기(TTS)에 쓸 Clova Voice 화자. 기본 ndain(신뢰감 있는 톤의 한국어 여성 아나운서).
CLOVA_VOICE_SPEAKER=ndain

